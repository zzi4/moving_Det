{
  "name": "moving-det-progress-report",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "lan": "node scripts/start-lan.mjs",
    "lan:url": "node scripts/lan-url.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test:status": "node --test server/status.test.mjs",
    "test:evidence": "node --test server/evidence.test.mjs",
    "test:formal-status": "node --test server/formal-status.test.mjs",
    "test:formal-data": "node --experimental-strip-types --test app/formal-report-data.test.mjs",
    "test:formal-view": "node --experimental-strip-types --test app/components/formal-report.test.mjs",
    "test:client-state": "node --test app/components/live-status-state.test.mjs",
    "test:pipeline-state": "node --test app/components/pipeline-layer-state.test.mjs",
    "test:lan": "node --test scripts/lan-url.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "test": "npm run test:status && npm run test:evidence && npm run test:formal-status && npm run test:formal-data && npm run test:formal-view && npm run test:client-state && npm run test:pipeline-state && npm run test:lan && npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
